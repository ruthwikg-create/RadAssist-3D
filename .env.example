NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# For a protected deployment, set the same secret on backend and frontend. Do not commit real values.
NEXT_PUBLIC_RADASSIST_API_TOKEN=
RADASSIST_API_TOKEN=
RADASSIST_REQUIRE_AUTH=false
RADASSIST_TRUSTED_HOSTS=localhost,127.0.0.1
RADASSIST_ENABLE_DOCS=false
RADASSIST_FORCE_HTTPS=false
RADASSIST_DEVICE=auto
RADASSIST_MODEL_PATH=/app/models/spleen_unet_model.pt
RADASSIST_CASE_ROOT=/app/data/cases
RADASSIST_ALLOW_DEMO=false
RADASSIST_MAX_UPLOAD_BYTES=536870912
RADASSIST_MAX_EXTRACTED_BYTES=2147483648
RADASSIST_MESH_MAX_VERTICES=250000
RADASSIST_MESH_STEP_SIZE=2

# Automatically delete stored derived case artifacts older than this many hours; 0 disables cleanup.
RADASSIST_CASE_RETENTION_HOURS=0
